# ==============================================================================
# MECHmetrIQ (MechOneHub) — Environment Variables Reference (v3.1.0)
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BUILD-TIME PUBLIC VARIABLES (Baked into Next.js client bundle at build)
#    In CI/CD, store these as GitHub Environment variables (`staging`, `production`).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 2. RUNTIME CONFIGURATION (Cloud Run `--set-env-vars`, non-secret)
# ------------------------------------------------------------------------------
# Payments mode: MUST be `test` in local & staging. Startup guard aborts if `live` outside https://mechonehub.com
PAYMENTS_MODE=test
GCS_CAD_BUCKET=
PUBSUB_CAD_TOPIC=cad-analysis-jobs
UPSTASH_REDIS_REST_URL=

# Raw Material Marketplace Seller Details (optional overrides for proforma invoices)
RM_SELLER_LEGAL_NAME=MECHmetrIQ
RM_SELLER_GSTIN=
RM_SELLER_ADDRESS=
RM_SELLER_EMAIL=hello@mechonehub.com

# Local Dev / Legacy Parser Fallback (used only when GCS_CAD_BUCKET is empty)
SMARTQUOTE_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. RUNTIME SECRETS (GCP Secret Manager `--set-secrets` in `asia-south1`)
#    Each environment (`mechonehub-staging`, `mechonehub-prod`) gets distinct values.
# ------------------------------------------------------------------------------
# Shared secret injected by Cloudflare Worker (`X-Origin-Verify`); checked in `src/proxy.ts`
ORIGIN_VERIFY_SECRET=
# Optional previous secret during zero-downtime 90-day rotation
ORIGIN_VERIFY_SECRET_PREVIOUS=

# Web service ONLY (NEVER give to `mechonehub-cad-worker`)
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte base64/hex key for vendor KYC column encryption (keep offline backup with 2 owners!)
KYC_ENCRYPTION_KEY=

# HMAC-SHA256 shared secret between `mechonehub-cad-worker` and `/api/internal/cad-result`
CAD_CALLBACK_SECRET=

# Upstash Redis REST token (caching rm_rates/sq_settings + auth/upload rate limiting)
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSN for server & worker error reporting (PII-scrubbed)
SENTRY_DSN=

# Razorpay credentials (use TEST mode keys in staging, always)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local Dev / CI Smoke Test API key for `POST /analyze`
SMARTQUOTE_API_KEY=dev-key

# ------------------------------------------------------------------------------
# 4. ISOLATED PYTHON CAD WORKER (`services/smartquote`)
#    Holds ZERO database credentials.
# ------------------------------------------------------------------------------
WEB_CALLBACK_URL=http://localhost:3000
SMARTQUOTE_MAX_MB=50
SMARTQUOTE_TIMEOUT_S=120
WEB_CONCURRENCY=1

# ------------------------------------------------------------------------------
# 5. CI/CD & GITHUB ENVIRONMENTS (`staging`, `production`, `backups`)
# ------------------------------------------------------------------------------
# GitHub Environment Variables (`vars.*`):
#   GCP_PROJECT=mechonehub-staging | mechonehub-prod
#   GCP_WIF_PROVIDER=projects/<NUM>/locations/global/workloadIdentityPools/github/providers/github-actions
#   GCP_WIF_PROVIDER_PROD=projects/<PROD_NUM>/locations/global/workloadIdentityPools/github/providers/github-actions
#   BACKUP_AGE_PUBLIC_KEY=age1...
#   PROD_SUPABASE_URL / PROD_SUPABASE_ANON_KEY (for supabase-keepalive.yml)
#   STAGING_SUPABASE_URL / STAGING_SUPABASE_ANON_KEY (for supabase-keepalive.yml)
#
# GitHub Environment Secrets (`secrets.*`):
#   SUPABASE_SESSION_POOLER_URL=postgresql://postgres.<REF>:<PASS>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#   PROD_SUPABASE_SESSION_POOLER_URL=postgresql://backup_reader.<REF>:<PASS>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
